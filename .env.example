# RevenueCat public SDK keys (platform-specific — see RevenueCat dashboard > Project Settings > API Keys).
# Copy this file to .env and fill in real values before building the native (iOS/Android) app.
# Not read in plain browser dev (npm run dev) — that build uses LocalMockPaymentService instead. See src/lib/payments.ts.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Supabase project (Project Settings > API). Required: accounts, workout
# history sync, Train Together, chat, parks (src/lib/supabaseClient.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Test builds only: gives every user premium. Never set on the live site.
# VITE_FORCE_PREMIUM_FOR_TESTING=true

# Map tile provider key for src/pages/MapPage.tsx (Stadia Maps). Optional for
# local dev — Stadia serves tiles without a key for localhost/low-volume
# testing — but required before shipping to production or a native build.
# Get one at https://stadiamaps.com/.
VITE_MAP_TILES_API_KEY=
